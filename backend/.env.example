# 硅基流动 (SiliconFlow) 大模型 API 配置
SILICONFLOW_API_KEY=sk-xxxx-REPLACE-WITH-YOUR-KEY
SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 数据库配置
# MySQL (生产环境): mysql+pymysql://root:你的密码@localhost:3306/xishan_agri
# SQLite (开发环境，默认): 留空则自动使用 backend/xishan_agri.db
DB_URL=

# JWT 密钥（生产环境必须修改）
JWT_SECRET=CHANGE-ME-jwt-secret
