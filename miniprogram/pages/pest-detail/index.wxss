/* pages/pest-detail/index.wxss */

.pest-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  gap: 24rpx;
}

.pest-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pest-icon {
  font-size: 60rpx;
}

.pest-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.info-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.info-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  white-space: pre-line;
}
