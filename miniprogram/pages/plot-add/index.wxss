/* pages/plot-add/index.wxss */

.form-card {
  display: flex;
  flex-direction: column;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  flex-shrink: 0;
  width: 160rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.form-picker {
  font-size: 28rpx;
  color: var(--color-text-primary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.form-divider {
  height: 2rpx;
  background: var(--color-border);
}

/* —— 图片上传 —— */
.upload-card {
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
}

.upload-preview {
  width: 100%;
  height: 400rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
}

.upload-icon {
  font-size: 64rpx;
}

.upload-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.upload-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
