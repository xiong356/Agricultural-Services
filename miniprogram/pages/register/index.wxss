/* pages/register/index.wxss */

.page-wrap {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 0 48rpx;
  padding-top: 80rpx;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 56rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.form-card {
  background: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 8rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx 0;
}

.input-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.input-field {
  font-size: 32rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}

.divider {
  height: 2rpx;
  background: var(--color-border);
}

.btn-register {
  width: 100%;
  height: 96rpx;
  background: var(--color-sage);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56rpx;
  letter-spacing: 8rpx;
}

.btn-register:active {
  opacity: 0.85;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}
