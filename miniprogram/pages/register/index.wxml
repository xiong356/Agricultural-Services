<!-- pages/register/index.wxml -->
<view class="page-wrap">

  <!-- 标题 -->
  <view class="header">
    <text class="header-title">注册账号</text>
    <text class="header-subtitle">填写信息，开启智慧农业服务</text>
  </view>

  <!-- 表单 -->
  <view class="form-card">
    <view class="input-group">
      <text class="input-label">姓名</text>
      <input class="input-field" placeholder="请输入真实姓名" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="input-group">
      <text class="input-label">手机号</text>
      <input class="input-field" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="input-group">
      <text class="input-label">密码</text>
      <input class="input-field" password="{{true}}" placeholder="至少 6 位" value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="input-group">
      <text class="input-label">确认密码</text>
      <input class="input-field" password="{{true}}" placeholder="再次输入密码" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
    </view>
    <view class="divider"></view>

    <view class="input-group">
      <text class="input-label">所在村庄（选填）</text>
      <input class="input-field" placeholder="如：王家村" value="{{village}}" data-field="village" bindinput="onInput" />
    </view>
  </view>

  <!-- 注册按钮 -->
  <view class="btn-register {{loading ? 'btn-disabled' : ''}}" bindtap="onRegister">
    {{loading ? '注册中...' : '注 册'}}
  </view>

</view>
