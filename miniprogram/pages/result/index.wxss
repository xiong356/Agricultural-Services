/* pages/result/index.wxss */

.page-wrap {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* —— 自定义导航栏 —— */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 100;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.nav-back-icon {
  font-size: 32rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.nav-share {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.nav-share-icon {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1;
}

/* —— 照片预览 —— */
.photo-area {
  height: 440rpx;
  background: #3A4A2E;
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-card);
}

.photo-placeholder {
  font-size: 28rpx;
  color: #FFFFFF;
  opacity: 0.8;
}

/* —— 历史记录来源信息 —— */
.history-source {
  background: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.source-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.source-info {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* —— 诊断卡片 —— */
.diagnosis-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.severity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.severity-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.severity-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-red);
}

.severity-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.disease-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.meta-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.meta-value.sage {
  color: var(--color-sage);
  font-weight: 600;
}

.meta-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--color-border);
}

/* —— 防治建议 —— */
.treatment-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.treatment-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.treatment-icon {
  font-size: 30rpx;
}

.treatment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.treatment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.treatment-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-sage);
  flex-shrink: 0;
}

.row-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  min-width: 140rpx;
}

.row-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  flex: 1;
}

/* —— 删除按钮 —— */
.delete-btn {
  margin-top: 32rpx;
}
